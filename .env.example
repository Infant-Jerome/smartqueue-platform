# Preferred: full DB URL (Render Postgres, production). Takes precedence when set.
# Examples:
#   DATABASE_URL=sqlite:///./smartqueue.db
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smartqueue_db
DATABASE_URL=

# Fallback field-based config (used when DATABASE_URL is empty)
DATABASE_TYPE=sqlite
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=smartqueue_db

JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

APP_NAME=SmartQueue
APP_VERSION=1.0.0
DEBUG=True

# Comma-separated allowed origins (no spaces required)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- N1-Core notifications (Phase 5B): placeholders only, never real secrets. ---
NOTIFS_ENABLED=True
APPROACHING_THRESHOLD=2
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
PUSH_ENABLED=false
PUSH_FROM=
PUSH_HOST=
PUSH_PORT=443
PUSH_USER=
PUSH_PASS=
SMS_ENABLED=false
SMS_FROM=
SMS_HOST=
SMS_PORT=443
SMS_USER=
SMS_PASS=

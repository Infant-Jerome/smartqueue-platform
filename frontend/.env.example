# Copy to .env for local dev, or set in Vercel project settings for production.
# Dev (Vite proxy): keep the relative path so /api -> http://localhost:8000
VITE_API_BASE_URL=/api/v1

# Production example (Render backend URL):
# VITE_API_BASE_URL=https://smartqueue-api.onrender.com/api/v1

# Optional independent WebSocket base (wss). When unset, it is derived from
# VITE_API_BASE_URL (http->ws) or from the page origin over wss on HTTPS.
# VITE_WS_BASE_URL=wss://smartqueue-api.onrender.com/api/v1
